environment = "development"
project_name = "ai-language-tutor"

# Cloudflare Pages is free-tier compatible.
enable_cloudflare_pages = true
cloudflare_account_id   = "replace-with-cloudflare-account-id"
production_branch       = "main"
cloudflare_pages_custom_domain = "ai-language-tutor.caps-labs.com"

# Leave disabled until a Supabase organization and a database password are ready.
enable_supabase           = false
supabase_organization_id  = "replace-with-supabase-organization-id"
supabase_database_password = "replace-with-a-long-random-password"
supabase_region           = "sa-east-1"

site_url = "http://localhost:3000"
additional_redirect_urls = [
  "http://localhost:3000/**",
]

# Google Cloud backend. The project must already exist and have billing enabled.
enable_google_cloud = false
google_project_id   = "replace-with-google-project-id"
google_region       = "us-east1"

# Enable only after pushing the backend image and adding all secret versions.
enable_cloud_run_backend = false
backend_container_image  = null
backend_supabase_url      = "https://replace-with-project-ref.supabase.co"
backend_public_url        = "https://replace-with-cloud-run-or-api-domain.example.com"
backend_allowed_origins = [
  "https://ai-language-tutor.caps-labs.com",
  "https://ai-language-tutor-development.pages.dev",
]
cloud_run_min_instances   = 0
cloud_run_max_instances   = 1

# Optional billing alerts at 50%, 80%, and 100%. This is not a hard spending cap.
enable_google_billing_budget = false
google_billing_account_id    = "000000-000000-000000"
google_monthly_budget_usd     = 5
